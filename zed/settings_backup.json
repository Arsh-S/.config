// Zed settings — synced with Cursor + Neovim config
{
  // === Agent servers ===
  "agent_servers": {
    "github-copilot-cli": { "type": "registry" },
    "gemini": { "type": "registry" },
    "cursor": { "type": "registry" },
    "codex-acp": { "type": "registry" },
    "claude-acp": { "type": "registry" }
  },

  // === Vim mode (from nvim) ===
  "vim_mode": true,
  "relative_line_numbers": true,
  "cursor_blink": false,

  // === Editor behavior (from nvim options.lua) ===
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "none",
  "vertical_scroll_margin": 8,

  // === Appearance (from Cursor + nvim) ===
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 15.0,
  "buffer_line_height": "standard",
  "ui_font_size": 16,
  "agent_ui_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Kanagawa Wave - No Italics"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "VSCode Icons for Zed (Dark)"
  },

  // === Formatting (from Cursor) ===
  "base_keymap": "VSCode",
  "use_on_type_format": true,
  "format_on_save": "off",

  // === Prettier defaults (from Cursor: printWidth 150, tabWidth 4) ===
  "prettier": {
    "printWidth": 150,
    "tabWidth": 4
  },

  // === Git (matching nvim gitsigns + lazygit workflow) ===
  "git": {
    "inline_blame": { "enabled": true },
    "git_gutter": "tracked_files"
  },

  // === Terminal ===
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 14
  },

  // === Language-specific formatters (from nvim conform.nvim + Cursor) ===
  "languages": {
    "JavaScript": {
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TSX": {
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "JSX": {
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "JSON": {
      "formatter": "prettier"
    },
    "JSONC": {
      "formatter": "prettier"
    },
    "Markdown": {
      "formatter": "prettier"
    },
    "HTML": {
      "formatter": "prettier"
    },
    "CSS": {
      "formatter": "prettier"
    },
    "SCSS": {
      "formatter": "prettier"
    },
    "Python": {
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-", "--quiet"]
        }
      }
    },
    "OCaml": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "Lua": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["-"]
        }
      }
    }
  },

  // === File type associations (from Cursor) ===
  "file_types": {
    "html": ["*.jinja"],
    "plaintext": ["*.txt"],
    "java": ["*.pde"],
    "python": ["*.py"]
  },

  // === Agent config ===
  "agent": {
    "use_modifier_to_send": false,
    "tool_permissions": {
      "default": "confirm",
      "tools": {}
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": []
  },

  // === Privacy ===
  "redact_private_values": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  // === Misc ===
  "session": {
    "trust_all_worktrees": true
  },
  "status_bar": {
    "show": true
  }
}
